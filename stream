<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>Stream</title>

    <style>
        html, body {
            margin: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000;
        }

        iframe {
            width: 100%;
            height: 100%;
            border: 0;
        }

        #message {
            color: white;
            font-family: sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
        }
    </style>
</head>

<body>

<script>
    const streamId = window.location.hash.substring(1);

    if (!streamId || !/^[a-zA-Z0-9_-]+$/.test(streamId)) {
        document.body.innerHTML =
            '<div id="message">No stream specified.</div>';
    } else {
        const iframe = document.createElement("iframe");

        iframe.src =
            "https://vdo.ninja/?view=" +
            encodeURIComponent(streamId) +
            "&videobitrate=10000&scale=100&cleanish";

        iframe.allow =
            "autoplay; fullscreen; microphone; camera";

        iframe.allowFullscreen = true;

        document.body.appendChild(iframe);
    }
</script>

</body>
</html>
